# AI Research Landscape Agent V2 — configuration template.
# Copy to `.env` and fill in what you have. `.env` is gitignored; never commit
# a real key. Every value here is read by api/config.py (see Settings.from_env).

# ---------------------------------------------------------------------------
# LLM (structured output: extraction, cluster naming, edge typing, synthesis)
# ---------------------------------------------------------------------------
# Which OpenAI-compatible backend to use: openai | openrouter | nim | local.
# "local" needs no key and points at e.g. Ollama's OpenAI shim by default.
LLM_PROVIDER=
# Generic key slot — wins over the provider-specific variables below when set.
LLM_API_KEY=
# Provider-specific keys (used when LLM_API_KEY is empty):
#   NVIDIA_API_KEY     -> https://build.nvidia.com -> "Get API Key" (free tier)
#   OPENROUTER_API_KEY -> https://openrouter.ai/keys
#   OPENAI_API_KEY     -> https://platform.openai.com/api-keys
NVIDIA_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
# Override the provider's default base URL (nim: https://integrate.api.nvidia.com/v1,
# openrouter: https://openrouter.ai/api/v1, local: http://localhost:11434/v1).
LLM_BASE_URL=
# NEVER guess a slug. Run `make verify-llm`: it lists the live catalogue and
# proves one real completion before you set this.
LLM_MODEL=
# Parallel LLM calls; lower this if you see 429s (NIM free tier is throttled).
LLM_CONCURRENCY=
# Bounded repair attempts per call when the model returns invalid JSON.
LLM_MAX_REPAIRS=
# Per-request timeout.
LLM_TIMEOUT_SECONDS=

# ---------------------------------------------------------------------------
# Retrieval (arXiv) — https://info.arxiv.org/help/api/tou.html
# ---------------------------------------------------------------------------
# Terms of Use floor is 3.0 s between requests; config REFUSES anything lower.
ARXIV_DELAY_SECONDS=
ARXIV_NUM_RETRIES=
ARXIV_PAGE_SIZE=
RETRIEVAL_MAX_RESULTS=
# Hours a cached arXiv response is fresh; stale cache is still used on outage.
RETRIEVAL_CACHE_TTL_HOURS=
# Test/diagnostic toggles — force offline mode / simulate a 429.
ARXIV_OFFLINE=
ARXIV_FORCE_429=

# ---------------------------------------------------------------------------
# Citation enrichment (both optional; the pipeline degrades without them)
# ---------------------------------------------------------------------------
# Semantic Scholar Graph API key: https://www.semanticscholar.org/product/api
# (keyless works but is aggressively rate-limited; keyed is 1 RPS).
S2_API_KEY=
# OpenAlex polite pool: just your email address -> https://docs.openalex.org/how-to-use-the-api/rate-limits-and-authentication
OPENALEX_MAILTO=
ENRICH_CONCURRENCY=
ENRICH_TTL_DAYS=
# Weight of the citation prior in the final blend.
CITATION_BLEND_WEIGHT=

# ---------------------------------------------------------------------------
# Reranking (cross-encoder + optional LLM judge)
# ---------------------------------------------------------------------------
RERANK_SEED_COUNT=
# Alias RERANK_TOP_COUNT is also accepted for this knob.
RERANK_FINAL_COUNT=
# Must sum to 1.0 — config refuses otherwise.
RERANK_BLEND_CE=
RERANK_BLEND_LLM=
RERANK_JUDGE_BATCH_SIZE=
# HuggingFace model ids; weights download into data/models/ (HF_HOME) on first use.
CROSS_ENCODER_MODEL=
CROSS_ENCODER_DEVICE=
CROSS_ENCODER_MAX_LENGTH=
CROSS_ENCODER_BATCH_SIZE=

# ---------------------------------------------------------------------------
# Extraction / embeddings / layout
# ---------------------------------------------------------------------------
# Bump deliberately: extractions are cached per (paper_id, prompt_version).
PROMPT_VERSION=
EXTRACT_TIMEOUT_SECONDS=
# Token-budget guard for prompts that list papers (runbook §13.4).
MAX_PAPERS_IN_PROMPT=
EMBED_MODEL=
EMBED_DEVICE=
UMAP_N_NEIGHBORS=
UMAP_MIN_DIST=
# Fixed seed: the map must be pixel-identical across reloads.
UMAP_RANDOM_STATE=
CLUSTER_MIN_SIZE_RATIO=
HDBSCAN_MIN_SAMPLES=

# ---------------------------------------------------------------------------
# Relationship graph
# ---------------------------------------------------------------------------
GRAPH_KNN_K=
GRAPH_COSINE_FLOOR=
GRAPH_COSINE_START=
GRAPH_EDGES_PER_NODE=
GRAPH_MIN_DENSITY=

# ---------------------------------------------------------------------------
# Full text (Phase 11; disabled until then)
# ---------------------------------------------------------------------------
FULLTEXT_ENABLED=
FULLTEXT_TOP_N=

# ---------------------------------------------------------------------------
# Stage hard caps in seconds (plan §13.2; a breach degrades loudly, never silently)
# ---------------------------------------------------------------------------
STAGE_CAP_RETRIEVAL_SECONDS=
STAGE_CAP_ENRICHMENT_SECONDS=
STAGE_CAP_RERANK_SECONDS=
STAGE_CAP_EXTRACTION_SECONDS=
STAGE_CAP_LAYOUT_SECONDS=
STAGE_CAP_SYNTHESIS_SECONDS=

# ---------------------------------------------------------------------------
# API / storage / security
# ---------------------------------------------------------------------------
# SQLite location; relative paths anchor at the project root.
DATABASE_PATH=
API_PORT=
# Comma-separated explicit origins (never "*" with credentials).
ALLOWED_ORIGINS=
# Empty = open (localhost only). Set when deployed: mutating endpoints then
# require `Authorization: Bearer <token>`. Generate: `openssl rand -hex 32`.
API_AUTH_TOKEN=
# true exposes the §13.3 debug endpoints; keep false anywhere shared.
DEBUG=
LOG_LEVEL=

# ---------------------------------------------------------------------------
# Set automatically by api/config.py at import time — listed so nobody
# "fixes" a surprise: model weights land in this repo, not ~/.cache.
#   HF_HOME=<repo>/data/models
#   SENTENCE_TRANSFORMERS_HOME=<repo>/data/models/sentence_transformers
# ---------------------------------------------------------------------------
